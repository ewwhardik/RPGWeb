datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  username       String          @unique
  passwordHash   String
  level          Int             @default(1)
  xp             Int             @default(0)
  gold           Int             @default(50)
  hp             Int             @default(50) // Hero Health (Max 50)
  maxHp          Int             @default(50)
  mp             Int             @default(50) // Hero Mana (Max 50)
  maxMp          Int             @default(50)
  isSleeping     Boolean         @default(false) // Rest at the Inn (Vacation Mode)
  currentPet     String?         // Equipped Pet identifier
  currentMount   String?         // Equipped Mount identifier
  streakCount    Int             @default(1)
  lastActiveDate DateTime        @default(now())
  title          String          @default("Novice Procrastinator")
  avatar         String          @default("warrior")
  characterClass String          @default("WARRIOR")
  prestigeLevel  Int             @default(0)
  vaultPulls     Int             @default(0)
  chronoShards   Int             @default(0)
  loginDayCount  Int             @default(1)
  lastLoginDate  DateTime        @default(now())
  claimedLoginDays String        @default("")
  dayStartHour   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  stats          UserStats?
  tasks          Task[]
  inventory      UserInventory[]
  logs           ActivityLog[]
  partyMember    PartyMember?
  pets           UserPet[]
  challenges     ChallengeParticipant[]
}

model UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  strength           Int      @default(10)
  intellect          Int      @default(10)
  vitality           Int      @default(10)
  dexterity          Int      @default(10)
  charisma           Int      @default(10)
  sanity             Int      @default(10)

  lastDecayCheck     DateTime @default(now())
  lastStrengthDate   DateTime @default(now())
  lastIntellectDate  DateTime @default(now())
  lastVitalityDate   DateTime @default(now())
  lastDexterityDate  DateTime @default(now())
  lastCharismaDate   DateTime @default(now())
  lastSanityDate     DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id             String    @id @default(cuid())
  userId         String
  type           String    @default("TODO") // HABIT, DAILY, TODO, REWARD
  title          String
  description    String?
  category       String    @default("INTELLECT")
  difficulty     String    @default("MEDIUM")
  xpReward       Int       @default(50)
  goldReward     Int       @default(15)
  status         String    @default("TODO")
  dueDate        DateTime?
  completedAt    DateTime?
  isRecurring    Boolean   @default(false)
  recurrenceType String?

  value          Float     @default(0)
  up             Boolean   @default(true)
  down           Boolean   @default(false)
  counterUp      Int       @default(0)
  counterDown    Int       @default(0)
  repeatDays     String?   @default("0,1,2,3,4,5,6")
  completedToday Boolean   @default(false)
  streak         Int       @default(0)
  cost           Int?
  checklist      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPet {
  id         String   @id @default(cuid())
  userId     String
  species    String
  potionType String   @default("Base")
  feedCount  Int      @default(0)
  isMount    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, species, potionType])
}

model Item {
  id               String          @id @default(cuid())
  name             String
  description      String
  humorQuote       String
  category         String
  price            Int
  statType         String
  statBoost        Int             @default(5)
  icon             String
  rarity           String          @default("COMMON")
  isCursed         Boolean         @default(false)
  curseDescription String?
  createdAt        DateTime        @default(now())

  inventories      UserInventory[]
}

model UserInventory {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  isEquipped Boolean  @default(false)
  durability Int      @default(100)
  acquiredAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  actionType String
  message    String
  xpChange   Int      @default(0)
  goldChange Int      @default(0)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Party {
  id            String        @id @default(cuid())
  name          String
  code          String        @unique
  bossName      String        @default("The Dread Procrastination Wyrm")
  bossMaxHp     Int           @default(2500)
  bossCurrentHp Int           @default(2500)
  bossRage      Int           @default(0)
  activeBuffs   String?       @default("{}")
  activeQuest   String?
  createdAt     DateTime      @default(now())

  members       PartyMember[]
}

model PartyMember {
  id       String   @id @default(cuid())
  partyId  String
  userId   String   @unique
  joinedAt DateTime @default(now())

  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Challenge {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("GENERAL")
  prizePool   Int      @default(100)
  creatorId   String
  tasksJson   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())
  isCompleted Boolean  @default(false)

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}
