datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  username       String          @unique
  passwordHash   String
  level          Int             @default(1)
  xp             Int             @default(0)
  gold           Int             @default(50)
  streakCount    Int             @default(1)
  lastActiveDate DateTime        @default(now())
  title          String          @default("Novice Procrastinator")
  avatar         String          @default("warrior")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  stats          UserStats?
  tasks          Task[]
  inventory      UserInventory[]
  logs           ActivityLog[]
}

model UserStats {
  id        String   @id @default(cuid())
  userId    String   @unique
  strength  Int      @default(10)
  intellect Int      @default(10)
  vitality  Int      @default(10)
  dexterity Int      @default(10)
  charisma  Int      @default(10)
  sanity    Int      @default(10)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String    @default("INTELLECT")
  difficulty  String    @default("MEDIUM")
  xpReward    Int       @default(50)
  goldReward  Int       @default(15)
  status      String    @default("TODO")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id               String          @id @default(cuid())
  name             String
  description      String
  humorQuote       String
  category         String
  price            Int
  statType         String
  statBoost        Int             @default(5)
  icon             String
  rarity           String          @default("COMMON")
  isCursed         Boolean         @default(false)
  curseDescription String?
  createdAt        DateTime        @default(now())

  inventories      UserInventory[]
}

model UserInventory {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  actionType String
  message    String
  xpChange   Int      @default(0)
  goldChange Int      @default(0)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
